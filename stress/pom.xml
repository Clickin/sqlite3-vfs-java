<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.clickin</groupId>
  <artifactId>sqlite3-vfs-stress</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Standalone rollback lock jcstress checks</name>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <vfs.artifact>sqlite3-vfs</vfs.artifact>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- https://repo.maven.apache.org/maven2/org/openjdk/jcstress/jcstress-core/maven-metadata.xml -->
    <jcstress.version>0.16</jcstress.version>
  </properties>
  <dependencies>
    <!-- Install the root artifact first; production never depends on jcstress. -->
    <dependency>
      <groupId>io.github.clickin</groupId>
      <artifactId>${vfs.artifact}</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jcstress</groupId>
      <artifactId>jcstress-core</artifactId>
      <version>${jcstress.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.openjdk.jcstress</groupId>
              <artifactId>jcstress-core</artifactId>
              <version>${jcstress.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>jcstress</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.openjdk.jcstress.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/TestList</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>java25</id>
      <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <vfs.artifact>sqlite3-vfs-java25</vfs.artifact>
      </properties>
      <build><directory>target/java25</directory></build>
    </profile>
  </profiles>
</project>
