<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.clickin</groupId>
  <artifactId>sqlite3-vfs-jdbc-java25</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Java 25 SQLite JVM engine with Arena VFS</name>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <endive.version>1.0.1</endive.version>
  </properties>
  <dependencies>
    <dependency><groupId>io.github.clickin</groupId><artifactId>sqlite3-vfs-java25</artifactId><version>0.1.0-SNAPSHOT</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>runtime</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>wasm</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>wasi</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>run.endive</groupId><artifactId>annotations</artifactId><version>${endive.version}</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.18</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.14.4</version><scope>test</scope></dependency>
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.53.4.0</version><scope>test</scope></dependency>
    <dependency><groupId>io.github.clickin</groupId><artifactId>sqlite3-vfs-java25</artifactId><version>0.1.0-SNAPSHOT</version><type>test-jar</type><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>target/java25</directory>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>native</directory><targetPath>META-INF</targetPath><includes><include>THIRD-PARTY.txt</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>run.endive</groupId><artifactId>endive-compiler-maven-plugin</artifactId><version>${endive.version}</version>
        <executions><execution><id>compile-sqlite</id><goals><goal>compile</goal></goals>
          <configuration><name>io.roastedroot.sqlite4j.SQLiteModule</name><wasmFile>${project.basedir}/target/sqlite-vfs.wasm</wasmFile></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        <configuration><annotationProcessorPaths><path><groupId>run.endive</groupId><artifactId>annotations-processor</artifactId><version>${endive.version}</version></path></annotationProcessorPaths></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        <configuration>
          <argLine>--illegal-native-access=deny</argLine>
          <failIfNoTests>true</failIfNoTests>
          <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
          <systemPropertyVariables><junit.jupiter.execution.timeout.default>60 s</junit.jupiter.execution.timeout.default></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
